# Copy to .env and fill in what you need: cp .env.example .env
# .env is gitignored. This file is committed, so never put a real value here.

# Gemini key for the AI verdict. Left empty, the engine returns a mock FAIL before the
# prompt is built. CI reads it from the GEMINI_API_KEY repository secret.
GEMINI_API_KEY=

# false shows the browser in runValidation.js and the on-demand runner. Default is headless.
# HEADLESS=false

# Daily runner only: widgets per batch. Default 15.
# DAILY_BATCH_SIZE=15

# On-demand runner only: the payload the backend dispatches. Usually passed per run instead.
# WIDGET_DATA='{"data":{"url":"<demo url>","type":"review_badge","configurations":{}}}'

# Basecamp reporting. Keep these unset locally: when they are set, a local run reports to the
# real Feedspace Basecamp project and can file cards. CI sets them in the workflows.
# BASECAMP_TOKEN=
# BASECAMP_ACCOUNT_ID=4294983
# BASECAMP_PROJECT_ID=19240348
# BASECAMP_CHAT_ID=7605911660
# BASECAMP_CARD_COLUMN_ID=5478412224
# BASECAMP_CARD_ASSIGNEE_ID=45133799
